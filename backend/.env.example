# Copy to .env for local runs. Never commit .env.
PORT=4000
# MongoDB Atlas connection string (free M0 cluster) or local mongodb://127.0.0.1:27017/my-quiz-app
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/my-quiz-app
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# The single admin account for CRUD endpoints
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=https://codelady-ship.github.io,http://localhost:3000,http://localhost:5173,http://localhost:4173
# Fill empty collections from src/data/questions.js on start (default true)
SEED_ON_START=true
